# ============================================================
# Sofrito Studio — Pivot Site Environment Template
# Job: 1
# MCP: cloudflare-bindings
# Last updated: 2026-09-04
# Purpose: Documents every env var the Worker + CI need.
# Copy to .dev.vars for `npx wrangler dev` local development.
# Production values go to GitHub Secrets (CI) and
# `npx wrangler secret put <NAME>` (manual deploys).
# ============================================================

# --- Email (Resend) ---
# https://resend.com/api-keys
RESEND_API_KEY=re_dummy_replace_me
RESEND_FROM=hello@sofritostudio.com
RESEND_FROM_NAME=Sofrito Studio
NOTIFICATION_EMAIL=owner@sofritostudio.com

# --- Automation (Zapier) ---
# Zapier catch hook URL (new lead). Used by WEBHOOK_QUEUE consumer.
# Lead -> Google Sheets + owner email.
WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/<code>

# --- Admin ---
# 32+ char random string. Protects /api/leads, /api/dashboard, /api/revenue.
# Generate: openssl rand -hex 32
ADMIN_KEY=dummy_admin_key_generate_me_32_chars

# --- Payments (Stripe) ---
# Payment processor (D2): Stripe for sessions/services/projects. Gumroad dormant/legacy only.
# https://dashboard.stripe.com/webhooks — create endpoint: <site>/api/stripe-webhook
#   subscribe to: invoice.paid, checkout.session.completed, charge.refunded
STRIPE_WEBHOOK_SECRET=whsec_dummy
# Secret key (sk_test_...) used by /api/lead to create Checkout sessions — test mode only.
# https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_test_dummy
# Turnstile (D3): managed (checkbox-less) widget in Cloudflare dashboard.
# Site key goes in sprint.html / sprint-boh.html (replace SITEKEY-PLACEHOLDER).
# Secret key is verified server-side in handleApiLead.
TURNSTILE_SECRET_KEY=turnstile_secret_dummy

# --- Bookings (Calendly) ---
# Webhook signing key for /api/calendly-webhook HMAC-SHA256 verify.
# https://calendly.com/integrations/webhooks/signature_verification
CALENDLY_WEBHOOK_SIGNING_KEY=dummy_calendly_key

# --- Pixel (TikTok) ---
# TikTok Events API access token (server-side event forwarding).
TIKTOK_EVENTS_TOKEN=dummy_tiktok_token

# --- Newsletter (Buttondown) ---
# https://buttondown.com/settings/developer
BUTTONDOWN_API_KEY=dummy_buttondown_key
BUTTONDOWN_EMAIL=hello@sofritostudio.com

# --- Content generation (OpenRouter) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-dummy

# --- CI/CD (GitHub Secrets) ---
# Cloudflare API token with Workers Scripts:Edit + D1 + Queues permissions
CLOUDFLARE_API_TOKEN=dummy
# Cloudflare account ID (dashboard: Workers > Overview > right side)
CLOUDFLARE_ACCOUNT_ID=dummy