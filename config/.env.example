# ============================================================
# Sofrito Studio — Consolidated Environment Template
# Copy to config/.env and fill in real values. NEVER commit .env.
# ============================================================

# --- Email (Buttondown) ---
BUTTONDOWN_API_KEY=
BUTTONDOWN_USERNAME=joshortiz56

# --- Payments (Stripe — sessions/services/projects; decision 2026-09-08) ---
# Stripe Dashboard > Developers > API keys (worker.js invoice pipeline + /api/stripe-webhook)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Scheduling (Calendly — S19) ---
# Signing key for the webhook subscription; /api/calendly-webhook verifies
# Calendly-Webhook-Signature (t=<unix>,v1=<hex> HMAC-SHA256). Create the
# subscription at Calendly > Integrations & apps > Webhooks (events:
# invitee.created, invitee.canceled; URL: https://sofritostudio.com/api/calendly-webhook).
# The booking button swaps in automatically once KV site/config.session_url is set.
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- Cloudflare ---
# For wrangler deploy (or use `npx wrangler login` instead)
CF_API_TOKEN=

# --- Social posting ---
# Pinterest API v5
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
# Public image URL used as pin media (required to publish Pinterest pins)
PIN_MEDIA_URL=
# Meta (Facebook/Instagram)
META_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
# TikTok
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Analytics ---
GA4_MEASUREMENT_ID=

# --- Image generation (optional) ---
OPENAI_API_KEY=
